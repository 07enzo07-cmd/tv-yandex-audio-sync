<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vivax ↔ Яндекс Станция Mini 2"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Статус: Остановлено"
        android:textColor="#888888"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="380dp"
        android:layout_height="72dp"
        android:text="ВКЛЮЧИТЬ СИНХРОНИЗАЦИЮ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/btn_toggle_start"
        android:textColor="#FFFFFF"
        android:focusable="true"
        android:nextFocusDown="@+id/etIp"
        android:layout_marginBottom="32dp">
        <requestFocus />
    </Button>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP Станции: "
            android:textColor="#AAAAAA"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etIp"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:hint="192.168.1.100"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@drawable/et_ip_bg"
            android:padding="10dp"
            android:focusable="true"
            android:nextFocusUp="@+id/btnToggle"
            android:nextFocusDown="@+id/btnDelayReset"
            android:inputType="text" />
    </LinearLayout>

    <View
        android:layout_width="440dp"
        android:layout_height="1dp"
        android:background="#2A2A2A"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ручная микроподстройка (для всех приложений):"
        android:textColor="#DDDDDD"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvDelayInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Смещение: 0 мс (YouTube/Кинопаб: 160 мс, Twitch: 70 мс)"
        android:textColor="#00E5FF"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnDelayMinus"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:text="- 10 мс"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_action"
            android:textColor="@color/btn_action_text"
            android:focusable="true"
            android:nextFocusUp="@+id/etIp"
            android:nextFocusRight="@+id/btnDelayReset"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnDelayReset"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:text="Сброс (0)"
            android:textSize="14sp"
            android:background="@drawable/btn_reset"
            android:textColor="@color/btn_reset_text"
            android:focusable="true"
            android:nextFocusUp="@+id/etIp"
            android:nextFocusLeft="@+id/btnDelayMinus"
            android:nextFocusRight="@+id/btnDelayPlus"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnDelayPlus"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:text="+ 10 мс"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_action"
            android:textColor="@color/btn_action_text"
            android:focusable="true"
            android:nextFocusUp="@+id/etIp"
            android:nextFocusLeft="@+id/btnDelayReset" />
    </LinearLayout>

</LinearLayout>
