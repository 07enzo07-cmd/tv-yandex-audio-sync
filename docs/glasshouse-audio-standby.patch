diff --git a/server/lib/saverpoweroff.js b/server/lib/saverpoweroff.js
index 4af31c5..0dfcf82 100644
--- a/server/lib/saverpoweroff.js
+++ b/server/lib/saverpoweroff.js
@@ -7,6 +7,7 @@
  * Strict ES5 for Node 0.12.2 on webOS 4.
  */
 var power = require('./power');
+var fs = require('fs');
 
 var MAX_MINUTES = 1440;
 
@@ -19,6 +20,12 @@ var later = function (fn, ms) {
   var timer = setTimeout(fn, ms);
   return function () { clearTimeout(timer); };
 };
+var lastAudioActivity = readAudioActivity;
+function readAudioActivity() {
+  try { return fs.statSync('/var/run/vox-audio-active').mtime.getTime(); }
+  catch (e) { return 0; }
+}
+
 var listening = false;
 // The wait under way: { minutes, since, cancel }.
 var pending = null;
@@ -68,6 +75,17 @@ function fire(wait) {
   var n = wait.minutes;
   // The state is read again: the change that ended the screen saver may still be on its way.
   if (!inScreenSaver(powerState()) || minutes() !== n) return;
+  var now = Date.now();
+  var lastAudio = lastAudioActivity();
+  var audioIdle = now - lastAudio;
+  var interval = n * 60000;
+  if (lastAudio > 0 && audioIdle >= 0 && audioIdle < interval) {
+    var remaining = interval - audioIdle;
+    console.log('saver-poweroff: sound activity extends the wait by ' + Math.ceil(remaining / 1000) + ' s');
+    wait.cancel = later(function () { fire(wait); }, remaining);
+    pending = wait;
+    return;
+  }
   console.log('saver-poweroff: screen saver on for ' + n + ' min, switching the TV off');
   control('powerOff', null, function (r) {
     if (!r || !r.ok) console.error('saver-poweroff: powerOff failed: ' + ((r && r.error) || 'no answer'));
@@ -126,6 +144,7 @@ function init(opts) {
   config = opts.config;
   liveState = opts.liveState || null;
   control = opts.control;
+  lastAudioActivity = opts.lastAudioActivity || readAudioActivity;
   if (opts.later) later = opts.later;
 }
 
