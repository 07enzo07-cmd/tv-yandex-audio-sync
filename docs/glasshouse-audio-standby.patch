@@ -111,3 +112,15 @@ function setup(minutes, state) {
 })();
 
 console.log('test-saver-poweroff.js passed');
+
+(function testSoundDefersStandby() {
+  var recent = Date.now() - 1000;
+  var t = setup(30, 'Screen Saver', function () { return recent; });
+  t.live()[0].fn();
+  assert.deepEqual(t.calls, []);
